# Copy values into .streamlit/secrets.toml (local) or GitHub Actions secrets (cloud cron)

FINMIND_TOKEN = "your_finmind_token"

# Public Streamlit app URL (for「觀看完整數據」link in email)
APP_URL = "https://your-app.streamlit.app"

# Permanent watchlist storage (required on Streamlit Cloud; local disk is ephemeral there)
# Create a classic/fine-grained PAT with Contents: Read and Write on this repo.
GITHUB_TOKEN = "ghp_xxxxxxxx"
GITHUB_REPO = "pochang529/Quant_Agent"
WATCHLIST_BRANCH = "persistent-data"

# Push channel (pick any combination)
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""
DISCORD_WEBHOOK_URL = ""

# Gmail SMTP (use App Password, not normal login password)
GMAIL_USER = "you@gmail.com"
GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"
GMAIL_TO = "you@gmail.com"
